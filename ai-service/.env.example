# ====================================================
# IntelliGuard - AI Computer Vision Service Environment Variables
# ====================================================

# ----------------------------------------------------
# 1. Application Configuration
# ----------------------------------------------------
APP_NAME="IntelliGuard AI"
ENVIRONMENT="development"
# Allowed CORS origins for Next.js frontend (comma-separated if multiple)
ALLOWED_ORIGINS="http://localhost:3000"

# Optional: Shared secret key for authenticating incoming requests from Next.js
AI_SERVICE_API_KEY=""

# ----------------------------------------------------
# 2. Computer Vision & Biometric Models
# ----------------------------------------------------
# Active InsightFace model pack (standardized on buffalo_s for lightweight 512MB RAM compatibility)
INSIGHTFACE_MODEL="buffalo_s"

# Concurrency semaphore limit for simultaneous ONNX / CPU inferences
MAX_CONCURRENT_INFERENCE="2"

# YOLO Person Detection Settings
YOLO_MODEL_NAME="yolov8n"
YOLO_MODEL_URL="https://huggingface.co/Xuban/yolo_weights_database/resolve/main/yolov8n.onnx"
YOLO_CHECKSUM="a7e5de35f0e094653cabcd67b4fa850a42693b2e9f251edc2a0931b937e7810e"
YOLO_CONFIDENCE_THRESHOLD="0.40"
YOLO_IOU_THRESHOLD="0.45"

# ----------------------------------------------------
# 3. Anti-Spoofing & Presentation Attack Detection (Dual MiniFASNet Ensemble)
# ----------------------------------------------------
ANTISPOOF_ENABLED="true"
# Live threshold: bona fide genuine face score >= 0.80
ANTISPOOF_LIVE_THRESHOLD="0.80"
# Spoof threshold: presentation attack score <= 0.45
ANTISPOOF_SPOOF_THRESHOLD="0.45"
# Ensemble strategy: "mean" or "min"
ANTISPOOF_ENSEMBLE_METHOD="mean"
# Optional custom weights location (defaults to ~/.cache/intelliguard/models)
ANTISPOOF_MODEL_DIR=""
MINIFASNET_V2_PATH=""
MINIFASNET_V1SE_PATH=""

# ----------------------------------------------------
# 4. Memory & Threading Tuning (Render 512MB RAM Optimization)
# ----------------------------------------------------
MALLOC_ARENA_MAX="2"
OMP_NUM_THREADS="1"
OPENBLAS_NUM_THREADS="1"
PYTHONUNBUFFERED="1"
