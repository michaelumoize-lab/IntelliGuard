generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ==========================================
// AUTHENTICATION (Better-Auth Required)
// ==========================================
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  alerts        Alert[]   @relation("ResolvedAlerts")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// CORE BUSINESS ENTITIES
// ==========================================
enum PersonCategory {
  employee
  student
  visitor
  contractor
}

enum PersonStatus {
  active
  inactive
  suspended
}

model Person {
  personCode      String         @id @map("person_code")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  email           String?        @unique
  phone           String?        @unique
  category        PersonCategory
  department      String?        @db.VarChar(100)
  status          PersonStatus   @default(active)
  faceImageUrl    String?        @map("face_image_url")
  faceImageFileId String?        @map("face_image_file_id")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  faceEmbeddings FaceEmbedding[]
  accessLogs     AccessLog[]
  alerts         Alert[]

  @@index([status], map: "idx_person_status")
  @@map("persons")
}

model FaceEmbedding {
  embeddingCode         String                      @id @map("embedding_code")
  personCode            String                      @map("person_code")
  embedding             Unsupported("vector(512)")?
  embeddingModel        String                      @default("buffalo_s") @map("embedding_model") @db.VarChar(100)
  embeddingModelVersion String?                     @map("embedding_model_version") @db.VarChar(50)
  imagePath             String                      @map("image_path")
  imageHash             String?                     @unique @map("image_hash")
  qualityScore          Float?                      @map("quality_score")
  isActive              Boolean                     @default(true) @map("is_active")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  person     Person      @relation(fields: [personCode], references: [personCode], onDelete: Cascade)
  accessLogs AccessLog[]

  // Note: PostgreSQL HNSW vector index is applied via pgvector:
  // CREATE INDEX idx_face_embeddings_hnsw ON face_embeddings USING hnsw (embedding vector_cosine_ops) WITH (m = 16, ef_construction = 64);
  @@index([isActive], map: "idx_face_embedding_active")
  @@index([personCode], map: "idx_face_embedding_person_code")
  @@map("face_embeddings")
}

enum DeviceType {
  camera
  access_control
  sensor
  iot
}

enum DeviceStatus {
  online
  offline
  maintenance
  error
}

model Device {
  deviceCode      String       @id @map("device_code")
  deviceName      String       @map("device_name") @db.VarChar(100)
  serialNumber    String       @unique @map("serial_number")
  apiKeyHash      String       @unique @map("api_key_hash")
  location        String       @db.VarChar(150)
  ipAddress       String?      @map("ip_address")
  firmwareVersion String?      @map("firmware_version")
  deviceType      DeviceType   @default(camera) @map("device_type")
  status          DeviceStatus @default(offline)
  lastSeen        DateTime?    @map("last_seen")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  accessLogs AccessLog[]
  alerts     Alert[]

  @@index([serialNumber], map: "idx_device_serial")
  @@index([apiKeyHash], map: "idx_device_api_key_hash")
  @@map("devices")
}

// ==========================================
// ACCESS EVENTS & ALERTS (UNIFIED LOG)
// ==========================================
enum MatchStatus {
  matched
  unknown
  ambiguous
  rejected
}

enum AccessStatus {
  granted
  denied
}

enum AccessReason {
  face_match
  face_no_match
  insufficient_confidence
  time_restriction
  manual_override
  system_error
  spoof_detected
  unauthorized
  tailgating_detected
}

enum DoorAction {
  unlock
  lock
  no_action
}

model AccessLog {
  accessCode        String       @id @map("access_code")
  deviceCode        String?      @map("device_code")
  personCode        String?      @map("person_code")
  embeddingCode     String?      @map("embedding_code")
  matchStatus       MatchStatus  @map("match_status")
  accessStatus      AccessStatus @map("access_status")
  reason            AccessReason
  doorAction        DoorAction   @default(no_action) @map("door_action")
  confidenceScore   Float?       @map("confidence_score")
  embeddingDistance Float?       @map("embedding_distance")
  capturedImagePath String?      @map("captured_image_path")
  processingTimeMs  Int?         @map("processing_time_ms")
  createdAt         DateTime     @default(now()) @map("created_at")

  // Relations
  device        Device?        @relation(fields: [deviceCode], references: [deviceCode], onDelete: SetNull)
  person        Person?        @relation(fields: [personCode], references: [personCode], onDelete: SetNull)
  faceEmbedding FaceEmbedding? @relation(fields: [embeddingCode], references: [embeddingCode], onDelete: SetNull)

  @@index([deviceCode], map: "idx_accesslog_device_code")
  @@index([personCode], map: "idx_accesslog_person_code")
  @@index([embeddingCode], map: "idx_accesslog_embedding_code")
  @@index([createdAt], map: "idx_accesslog_created")
  @@index([accessStatus], map: "idx_accesslog_status")
  @@map("access_logs")
}

enum AlertType {
  unauthorized_access
  unknown_face
  device_offline
  system_error
}

enum Severity {
  low
  medium
  high
  critical
}

model Alert {
  alertCode  String    @id @map("alert_code")
  deviceCode String?   @map("device_code")
  personCode String?   @map("person_code")
  alertType  AlertType @map("alert_type")
  title      String    @db.VarChar(150)
  message    String    @db.Text
  severity   Severity  @default(medium)
  imagePath  String?   @map("image_path")
  resolved   Boolean   @default(false)
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  device   Device? @relation(fields: [deviceCode], references: [deviceCode], onDelete: SetNull)
  person   Person? @relation(fields: [personCode], references: [personCode], onDelete: SetNull)
  resolver User?   @relation("ResolvedAlerts", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([resolved], map: "idx_alert_resolved")
  @@index([createdAt], map: "idx_alert_created")
  @@index([deviceCode], map: "idx_alerts_device_code")
  @@index([personCode], map: "idx_alerts_person_code")
  @@map("alerts")
}
