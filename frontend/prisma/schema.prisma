generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ==========================================
// AUTHENTICATION (Better-Auth Required)
// ==========================================
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  alerts        Alert[]     @relation("ResolvedAlerts")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// CORE BUSINESS ENTITIES
// ==========================================
enum PersonCategory {
  employee
  student
  visitor
  contractor
}

enum PersonStatus {
  active
  inactive
  suspended
}

model Person {
  uuidId          String          @id @default(dbgenerated("uuidv7()")) @map("uuid_id") @db.Uuid
  personCode      String          @unique @map("person_code")
  firstName       String          @map("first_name")
  lastName        String          @map("last_name")
  email           String?         @unique
  phone           String?         @unique
  category        PersonCategory
  department      String?         @db.VarChar(100)
  status          PersonStatus    @default(active)
  faceImageUrl    String?         @map("face_image_url")
  faceImageFileId String?         @map("face_image_file_id")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  faceEmbeddings FaceEmbedding[]
  accessLogs     AccessLog[]
  alerts         Alert[]

  @@index([personCode], map: "idx_person_code")
  @@index([status], map: "idx_person_status")
  @@map("persons")
}

model FaceEmbedding {
  uuidId                String   @id @default(dbgenerated("uuidv7()")) @map("uuid_id") @db.Uuid
  embeddingCode         String   @unique @map("embedding_code")
  personUuidId          String   @map("person_uuid_id") @db.Uuid
  embedding             Unsupported("vector(512)")
  embeddingModel        String   @default("buffalo_s") @map("embedding_model") @db.VarChar(100)
  embeddingModelVersion String?  @map("embedding_model_version") @db.VarChar(50)
  imagePath             String   @map("image_path")
  imageHash             String?  @unique @map("image_hash")
  qualityScore          Float?   @map("quality_score")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  person     Person      @relation(fields: [personUuidId], references: [uuidId], onDelete: Cascade)
  accessLogs AccessLog[]

  // Note: PostgreSQL HNSW vector index is applied via pgvector:
  // CREATE INDEX idx_face_embeddings_hnsw ON face_embeddings USING hnsw (embedding vector_cosine_ops) WITH (m = 16, ef_construction = 64);
  @@index([embeddingCode], map: "idx_embedding_code")
  @@index([isActive], map: "idx_face_embedding_active")
  @@index([personUuidId], map: "idx_face_embedding_person_uuid")
  @@map("face_embeddings")
}

enum DeviceType {
  camera
  access_control
  sensor
  iot
}

enum DeviceStatus {
  online
  offline
  maintenance
  error
}

model Device {
  uuidId          String       @id @default(dbgenerated("uuidv7()")) @map("uuid_id") @db.Uuid
  deviceCode      String       @unique @map("device_code")
  deviceName      String       @map("device_name") @db.VarChar(100)
  serialNumber    String       @unique @map("serial_number")
  apiKeyHash      String       @unique @map("api_key_hash")
  location        String       @db.VarChar(150)
  ipAddress       String?      @map("ip_address")
  firmwareVersion String?      @map("firmware_version")
  deviceType      DeviceType   @default(camera) @map("device_type")
  status          DeviceStatus @default(offline)
  lastSeen        DateTime?    @map("last_seen")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  accessLogs AccessLog[]
  alerts     Alert[]

  @@index([deviceCode], map: "idx_device_code")
  @@index([serialNumber], map: "idx_device_serial")
  @@index([apiKeyHash], map: "idx_device_api_key_hash")
  @@map("devices")
}

// ==========================================
// ACCESS EVENTS & ALERTS (UNIFIED LOG)
// ==========================================
enum MatchStatus {
  matched
  unknown
  ambiguous
  rejected
}

enum AccessStatus {
  granted
  denied
}

enum AccessReason {
  face_match
  face_no_match
  insufficient_confidence
  time_restriction
  manual_override
  system_error
  spoof_detected
  unauthorized
  tailgating_detected
}

enum DoorAction {
  unlock
  lock
  no_action
}

model AccessLog {
  uuidId            String       @id @default(dbgenerated("uuidv7()")) @map("uuid_id") @db.Uuid
  accessCode        String       @unique @map("access_code")
  deviceUuidId      String?      @map("device_uuid_id") @db.Uuid
  personUuidId      String?      @map("person_uuid_id") @db.Uuid
  embeddingUuidId   String?      @map("embedding_uuid_id") @db.Uuid
  
  matchStatus       MatchStatus  @map("match_status")
  accessStatus      AccessStatus @map("access_status")
  reason            AccessReason
  doorAction        DoorAction   @default(no_action) @map("door_action")
  
  confidenceScore   Float?       @map("confidence_score")
  embeddingDistance Float?       @map("embedding_distance")
  capturedImagePath String?      @map("captured_image_path")
  processingTimeMs  Int?         @map("processing_time_ms")
  createdAt         DateTime     @default(now()) @map("created_at")

  // Relations
  device    Device?        @relation(fields: [deviceUuidId], references: [uuidId], onDelete: SetNull)
  person    Person?        @relation(fields: [personUuidId], references: [uuidId], onDelete: SetNull)
  embedding FaceEmbedding? @relation(fields: [embeddingUuidId], references: [uuidId], onDelete: SetNull)

  @@index([accessCode], map: "idx_access_code")
  @@index([deviceUuidId], map: "idx_accesslog_device_uuid")
  @@index([personUuidId], map: "idx_accesslog_person_uuid")
  @@index([embeddingUuidId], map: "idx_accesslog_embedding_uuid")
  @@index([createdAt], map: "idx_accesslog_created")
  @@index([accessStatus], map: "idx_accesslog_status")
  @@map("access_logs")
}

enum AlertType {
  unauthorized_access
  unknown_face
  device_offline
  system_error
}

enum Severity {
  low
  medium
  high
  critical
}

model Alert {
  uuidId       String        @id @default(dbgenerated("uuidv7()")) @map("uuid_id") @db.Uuid
  alertCode    String        @unique @map("alert_code")
  deviceUuidId String?       @map("device_uuid_id") @db.Uuid
  personUuidId String?       @map("person_uuid_id") @db.Uuid
  alertType    AlertType     @map("alert_type")
  title        String        @db.VarChar(150)
  message      String        @db.Text
  severity     Severity      @default(medium)
  imagePath    String?       @map("image_path")
  resolved     Boolean       @default(false)
  resolvedBy   String?       @map("resolved_by")
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  device   Device? @relation(fields: [deviceUuidId], references: [uuidId], onDelete: SetNull)
  person   Person? @relation(fields: [personUuidId], references: [uuidId], onDelete: SetNull)
  resolver User?   @relation("ResolvedAlerts", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([alertCode], map: "idx_alert_code")
  @@index([resolved], map: "idx_alert_resolved")
  @@index([createdAt], map: "idx_alert_created")
  @@index([deviceUuidId], map: "idx_alerts_device_uuid")
  @@index([personUuidId], map: "idx_alerts_person_uuid")
  @@map("alerts")
}
