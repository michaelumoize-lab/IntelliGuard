# ====================================================
# IntelliGuard - Frontend & API Gateway Environment Variables
# ====================================================

# ----------------------------------------------------
# 1. Database (PostgreSQL with pgvector extension)
# ----------------------------------------------------
# Pooled database connection string (e.g. Neon, Supabase, or local PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@host:5432/intelliguard?sslmode=require"

# Direct database connection string (used for direct migrations without connection pooling)
DIRECT_URL="postgresql://user:password@host:5432/intelliguard?sslmode=require"

# ----------------------------------------------------
# 2. Application & Authentication
# ----------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Secret key used for session signing (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET="your-32-byte-base64-random-secret-key-here"

# Optional: OAuth Provider Credentials (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------
# 3. AI Microservice (FastAPI + InsightFace + YOLO)
# ----------------------------------------------------
FASTAPI_URL="http://localhost:8000"
# Optional: Shared secret key for authenticating requests between Next.js and FastAPI
AI_SERVICE_API_KEY=""

# ----------------------------------------------------
# 4. Biometric & Recognition Thresholds
# ----------------------------------------------------
# Minimum cosine similarity (0.0 to 1.0) required to recognize a registered face
FACE_MATCH_THRESHOLD="0.50"

# Minimum similarity threshold to prevent duplicate face enrollment (defaults to FACE_MATCH_THRESHOLD if unset)
FACE_DUPLICATE_THRESHOLD="0.50"

# Maximum confidence difference between top 2 distinct matched persons that triggers an ambiguous match warning
FACE_AMBIGUITY_MARGIN="0.05"

# Minimum composite face quality score (0.0 to 1.0) required for registration and clear recognition
MIN_FACE_QUALITY="0.50"

# ----------------------------------------------------
# 5. Cloud Storage (ImageKit CDN for Face Photos)
# ----------------------------------------------------
IMAGEKIT_PUBLIC_KEY="public_your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="private_your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
