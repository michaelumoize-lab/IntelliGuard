# --------------------------
ai-service/.venv/
ai-service/__pycache__/
ai-service/.pytest_cache/
ai-service/.mypy_cache/
ai-service/.ruff_cache/
.venv/


*.py[cod]
*.pyo

# --------------------------
# Environment Variables
# --------------------------
.env
*.env
*.env.local
*.env.production

# --------------------------
# Uploaded Images
# --------------------------
backend/app/uploads/

# --------------------------
# Logs
# --------------------------
*.log

# --------------------------
# Build Files
# --------------------------
build/
dist/
*.egg-info/

# --------------------------
# Alembic
# --------------------------
alembic/__pycache__/

# --------------------------
# IDE
# --------------------------
.vscode/
.idea/

