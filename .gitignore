# ==========================================
# IntelliGuard - .gitignore
# ==========================================

# --------------------------
# Frontend (Next.js)
# --------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.env.local

# --------------------------
# Backend (Python)
# --------------------------
backend/.venv/
backend/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

*.py[cod]
*.pyo

# --------------------------
# Environment Variables
# --------------------------
.env
*.env
*.env.local
*.env.production

# --------------------------
# Uploaded Images
# --------------------------
backend/app/uploads/

# --------------------------
# Logs
# --------------------------
*.log

# --------------------------
# Build Files
# --------------------------
build/
dist/
*.egg-info/

# --------------------------
# Alembic
# --------------------------
alembic/__pycache__/

# --------------------------
# IDE
# --------------------------
.vscode/
.idea/

# --------------------------
# OS Files
# --------------------------
.DS_Store
Thumbs.db