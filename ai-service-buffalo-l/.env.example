# ====================================================
# IntelliGuard - AI Service (Buffalo_L) Environment Variables
# ====================================================

APP_NAME="IntelliGuard AI (Buffalo_L)"
ENVIRONMENT="development"
PORT=8001
ALLOWED_ORIGINS="http://localhost:3000"

# Optional: Shared secret key for authenticating incoming requests from Next.js
AI_SERVICE_API_KEY=""

# Model configuration
INSIGHTFACE_MODEL="buffalo_l"
INSIGHTFACE_DET_SIZE_W=640
INSIGHTFACE_DET_SIZE_H=640

# Local multithreading (0 = all cores)
ORT_NUM_THREADS=0
ORT_ENABLE_MEM_ARENA=true
MAX_CONCURRENT_INFERENCE=4

# YOLO Person Detection Settings
YOLO_MODEL_NAME="yolov8n"
YOLO_MODEL_URL="https://huggingface.co/Xuban/yolo_weights_database/resolve/main/yolov8n.onnx"
YOLO_CHECKSUM="a7e5de35f0e094653cabcd67b4fa850a42693b2e9f251edc2a0931b937e7810e"
YOLO_CONFIDENCE_THRESHOLD="0.40"
YOLO_IOU_THRESHOLD="0.45"
